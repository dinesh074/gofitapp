# gofit.today backend environment template.
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Database ----------------------------------------------------------------
# Set a Postgres URL (Supabase/Neon/etc.) for production. Leave BLANK to use a
# local SQLite file (community.db) — zero setup, great for local dev.
# URL-encode special chars in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Postgres schema that isolates our tables from anything else in the database.
PG_SCHEMA="gofit"
# Connection pool sizing (tune for load). For high throughput use Supabase's
# TRANSACTION pooler (host port 6543), which multiplexes many clients onto few
# server connections; session mode (5432) holds one server conn per pool slot.
# PG_POOL_MIN="2"
# PG_POOL_MAX="20"
# PG_POOL_TIMEOUT="10"

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key"
# FOOD_MODEL="gemini-3.5-flash-lite"   # optional

# --- Google Sign-In ----------------------------------------------------------
# Public web OAuth client ID from Google Cloud Console (safe to ship).
GOOGLE_CLIENT_ID="your_web_client_id.apps.googleusercontent.com"

# --- Email (Resend) -----------------------------------------------------------
# Powers the welcome email on signup and the email-code (OTP) sign-in option.
# Create a free account at https://resend.com, verify your sending domain
# (build.in), then create an API key. Leave unset to skip real sends -- OTP
# codes are still generated/stored, and (only with ALLOW_DEV_LOGIN=1) returned
# directly in the /auth/otp/request response so you can test without email.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# RESEND_FROM="gofit.today <info@build.in>"

# --- TEST MODE ---------------------------------------------------------------
# Set to 1 to enable POST /auth/dev (a shared Tester account, no Google needed).
# Leave OFF in production.
# ALLOW_DEV_LOGIN="1"

# --- Storage (Supabase Storage, for post images) ------------------------------
# From Dashboard -> Settings -> API. The service_role key is server-only --
# never ship it to the app. Requires the `community-photos` bucket to exist
# (create it once in Dashboard -> Storage if it doesn't already).
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# --- Payments (Razorpay) -----------------------------------------------------
# From Razorpay Dashboard → Settings → API Keys. The SECRET is server-only.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_key_secret"
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"   # Dashboard → Webhooks
# PRO_PRICE_PAISE="29900"   # ₹299 (in paise)
# PRO_CURRENCY="INR"
# PRO_PLAN_NAME="gofit.today Pro"

# --- Optional hardening ------------------------------------------------------
# APP_ENV="production"    # enables prod config/security warnings at startup
# APP_API_KEY=""          # require matching X-API-Key on /analyze
# ALLOWED_ORIGINS="https://app.gofit.today,https://gofit.today"  # lock CORS in prod
# FREE_SCANS="3"          # free food scans per account before paywall
# RATE_PER_MIN="20"
# RATE_PER_DAY="200"

# --- Audit log (GET /admin/audit) --------------------------------------------
# A permanent, append-only record of every payment order/verify/webhook event
# (success AND failure) plus sign-ins -- see audit.py. The audit_log table is
# always written regardless of this setting; ADMIN_KEY only gates the READ
# endpoint. Leave unset to keep that endpoint 404ing (data still recorded,
# just not queryable over HTTP -- use SQL directly instead). Set a long random
# value here (openssl rand -hex 32) once you actually want to check it via
# curl -H "X-Admin-Key: ..." https://your-api/admin/audit
# ADMIN_KEY=""
